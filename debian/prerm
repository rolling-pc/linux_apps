#!/bin/sh
# prerm for linux-apps.
#
# SINGLE SOURCE OF TRUTH: the CPack build embeds script/<name> verbatim via
# CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA, and debian/<name> is a byte-for-byte copy
# of this file.  Edit here, then re-copy to debian/.
#
# No #DEBHELPER# token on purpose; see the note in script/preinst.

set -e

SERVICE_UNITS="rolling_helper rolling_config rolling_flash"

case "$1" in
    remove)
        ;;
    upgrade|deconfigure)
        ;;
    failed-upgrade)
        # The new package failed to configure; stay out of the way.
        exit 0
        ;;
    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

have_systemctl() {
    command -v systemctl >/dev/null 2>&1
}

service_units_present() {
    found=""
    for unit in $SERVICE_UNITS; do
        for dir in /lib/systemd/system /usr/lib/systemd/system; do
            if [ -f "${dir}/${unit}.service" ]; then
                found="$found ${unit}.service"
                break
            fi
        done
    done
    printf '%s' "$found"
}

have_systemctl || exit 0

units=$(service_units_present)
[ -n "$units" ] || exit 0

# Stop before the binaries disappear.  Never disable on upgrade: the postinst of
# the new version enables the units again, and disabling here would briefly drop
# the WantedBy symlinks for no benefit.
systemctl stop $units 2>/dev/null || true

if [ "$1" = "remove" ]; then
    systemctl disable $units 2>/dev/null || true
fi

exit 0
