#!/usr/bin/make -f
# debian/rules for linux-apps; see debian/rules(5) and dh(1).
#
# Build system: CMake.  The top-level CMakeLists.txt runs the upstream "install"
# helper script at install time, which populates <build>/release/dpkg, and then
# installs that tree with RELATIVE DESTINATIONs.  override_dh_auto_install sets
# DESTDIR=debian/tmp and prefix=/, so the staged tree is
#   debian/tmp/opt/rolling/...        (services, MA helper, drop directory)
#   debian/tmp/usr/lib/systemd/system/... (units and environment drop-ins)
#   debian/tmp/usr/...                (udev rules, D-Bus policy)
# exactly matching the paths listed in debian/linux-apps.install.in.

export DH_VERBOSE = 1

# Hardening; see Policy 4.9.1 and dpkg-buildflags(1).
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_APPEND  = -Wall
export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

# Which (project, OEM) pair to package; defaults to rw350r/dell.  The values are
# the section names from rw350r_config / rw101_config.  Override them either way:
#
#   dpkg-buildpackage -us -uc -b "--eval=PROJECT:=rw101" "--eval=OEM:=lenovo"
#   DEB_BUILD_OPTIONS="project=rw101 oem=lenovo" dpkg-buildpackage -us -uc -b
#
# dpkg-buildpackage passes --eval= on to make as a command-line variable
# assignment, which wins over "?=".  (Do not use the shorter -Dproject= form:
# make reads that as --debug.)  DEB_BUILD_OPTIONS arrives as an environment
# variable, so it is unpacked explicitly below.
PROJECT ?= rw350r
OEM     ?= dell

ifneq ($(filter project=%,$(DEB_BUILD_OPTIONS)),)
  PROJECT := $(patsubst project=%,%,$(filter project=%,$(DEB_BUILD_OPTIONS)))
endif
ifneq ($(filter oem=%,$(DEB_BUILD_OPTIONS)),)
  OEM := $(patsubst oem=%,%,$(filter oem=%,$(DEB_BUILD_OPTIONS)))
endif

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure --sourcedirectory=. --builddirectory=build -- \
	  -DCMAKE_INSTALL_PREFIX=/ \
	  -DBUILD_DEB=yes \
	  -DBUILD_BY_LIB=1 \
	  -DPROJECT_BUILD=$(PROJECT) \
	  -DOEM_BUILD=$(OEM)

# dh_auto_build is pinned explicitly instead of relying on debhelper's
# auto-detection: a build was observed where the sequence ran configure ->
# install with no compilation in between (no "Building C object" in the log),
# so the staged tree never saw the freshly linked binaries and the .deb
# shipped only the configure-time .ini copies.  Driving it directly (serially,
# no -j) also sidesteps the gdbus-codegen ordering race in
# rolling_flash_service/CMakeLists.txt.
override_dh_auto_build:
	cmake --build build

# dh_auto_install is deliberately not used.  debhelper's CMake buildsystem may
# hand its own --prefix to "cmake --install", which would override the prefix
# this package needs and silently relocate the tree to
# debian/tmp/usr/opt/rolling -- dh_install would then fail on every path.
# Driving the install step directly pins prefix and DESTDIR, which is exactly
# what CPack does internally, so both build paths stage the same tree.
#
# The upstream install helper runs from an install(CODE) rule and fills
# <build>/release/dpkg; the install(DIRECTORY) rules then copy it out.
#
# The staged tree is target-dependent, so the install list is per-target too:
# debian/linux-apps.install.in lists every path any supported (project, OEM)
# pair can produce, and the loop below copies only the entries that matched
# something on this target into debian/linux-apps.install.  Two behaviours of
# dh_install make this necessary:
#   * it aborts with "missing files, aborting" on a pattern matching nothing
#     (rolling_helper_service/ is empty unless BUILD_DOWN_TOOL=yes,
#     rolling_ma_service/ only exists for BUILD_MA=yes);
#   * it cannot create directories, so the empty runtime drop directory
#     rolling_fw_pkg/ has to be made here instead.
# When an entry matched nothing but its directory was staged empty, the empty
# directory is created in the package tree and the staged copy removed, so
# debian/tmp mirrors the payload and dh_missing stays quiet.  Anything staged
# that no entry claims is still reported by dh_missing (compat 13 =
# --fail-missing), so a typo in the template cannot silently drop files.
override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/tmp cmake --install build --prefix /
	: > debian/linux-apps-mtk-rw350r-dell.install
	while read -r src dst; do \
	    case "$$src" in ''|'#'*) continue ;; esac; \
	    if ls -d debian/tmp/$$src >/dev/null 2>&1; then \
	        printf '%s %s\n' "$$src" "$$dst" >> debian/linux-apps-mtk-rw350r-dell.install; \
	    else \
	        d=$${src%/*}; \
	        if [ -d debian/tmp/$$d ] && [ -z "$$(ls -A debian/tmp/$$d)" ]; then \
	            install -d -m 0755 "debian/linux-apps-mtk-rw350r-dell/$$d"; \
	            rmdir "debian/tmp/$$d"; \
	        fi; \
	    fi; \
	done < debian/linux-apps.install.in

# The systemd units are shipped as plain staged files via the install list, and
# the maintainer scripts enable/start them explicitly (they must, because the
# very same scripts are used by the CPack build, where no debhelper snippets
# exist).  dh_installsystemd is therefore disabled: leaving it on would inject
# deb-systemd-helper calls into postinst/postrm and make the maintainer scripts
# of the two build paths differ.
override_dh_installsystemd:

# Byte-for-byte payload parity with the CPack build: CPack does not strip, so
# neither may we.  dh_strip/dh_dwz would rewrite every ELF file after
# dh_auto_install and the two packages would no longer be identical.
# Enable stripping in both paths together if release binaries are wanted.
override_dh_strip:

override_dh_dwz:

# The services link against prebuilt static archives and against libfwupd,
# neither of which resolves cleanly from the staged tree; keep dpkg-shlibdeps'
# strict undefined-symbol check off.
override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info

override_dh_auto_clean:
	dh_auto_clean
	rm -rf build
	rm -rf debian/tmp
	rm -f debian/linux-apps-mtk-rw350r-dell.install
	rm -f $(CURDIR)/../linux-apps_*
	rm -f $(CURDIR)/../linux-apps-*
