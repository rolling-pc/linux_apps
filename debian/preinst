#!/bin/sh
# preinst for linux-apps.
#
# SINGLE SOURCE OF TRUTH: the CPack build embeds script/<name> verbatim via
# CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA, and debian/<name> is a byte-for-byte copy
# of this file, so a cpack build and a dpkg-buildpackage build ship exactly the
# same maintainer scripts.  Edit here, then re-copy to debian/.
#
# No #DEBHELPER# token on purpose: all systemd handling is done explicitly
# below, and dh_installsystemd is disabled in debian/rules, so debhelper has no
# snippets to inject.  Keeping the token out is what makes the two packages
# byte-identical.

set -e

SERVICE_UNITS="rolling_helper rolling_config rolling_flash"

# FCC unlock helpers are named after the modem's idVendor:idProduct.  Only these
# names are ever touched, never the whole directory (Policy 10.7.4).
FCC_IDS="14c3:4d75 2cb7:01a2 2cb7:0301 413c:8209 413c:8211 413c:8213 413c:8215"

MM_DROPIN_DIR="/etc/systemd/system/ModemManager.service.d"
MM_DROPIN="${MM_DROPIN_DIR}/50-rolling-linux-apps.conf"

case "$1" in
    install|upgrade)
        ;;
    abort-upgrade)
        # The upgrade that was about to replace us failed; leave everything as
        # the previously installed version left it.
        exit 0
        ;;
    *)
        echo "preinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

have_systemctl() {
    command -v systemctl >/dev/null 2>&1
}

# Stop our own services so their binaries can be replaced.  Failures are not
# fatal: the service may be masked, may already be stopped, or systemd may not
# be running at all (chroot, container).
stop_services() {
    have_systemctl || return 0
    for unit in $SERVICE_UNITS; do
        for dir in /lib/systemd/system /usr/lib/systemd/system; do
            if [ -f "${dir}/${unit}.service" ]; then
                systemctl stop "${unit}.service" 2>/dev/null || true
                break
            fi
        done
    done
    return 0
}

# Remove the FCC unlock helpers this package copied into ModemManager's plugin
# directory in a previous postinst.  They are ours; the directory and any file
# belonging to modemmanager itself are left untouched.
remove_our_fcc_unlock() {
    for mm in /usr/lib/*/ModemManager /usr/lib/ModemManager /usr/lib64/ModemManager; do
        [ -d "$mm" ] || continue
        for id in $FCC_IDS; do
            rm -f "${mm}/fcc-unlock.d/${id}" 2>/dev/null || true
        done
    done
    return 0
}

mm_supports() {
    param="$1"
    for bin in /usr/sbin/ModemManager /usr/bin/ModemManager; do
        [ -x "$bin" ] || continue
        if "$bin" --help 2>&1 | grep -q -- "$param"; then
            return 0
        fi
        if "$bin" -h 2>&1 | grep -q -- "$param"; then
            return 0
        fi
    done
    return 1
}

# ModemManager must run with --test-quick-suspend-resume (and, where the build
# supports it, --test-low-power-suspend-resume) for the flashing sequence to
# work.  Older revisions of this package rewrote
# /lib/systemd/system/ModemManager.service with sed, which modified a file owned
# by another package and was silently undone by every modemmanager upgrade.
# A drop-in under /etc is the supported override mechanism: it leaves the
# packaged unit untouched and is removed again on purge.
configure_modemmanager() {
    unit_file=""
    for f in /lib/systemd/system/ModemManager.service /usr/lib/systemd/system/ModemManager.service; do
        if [ -f "$f" ]; then
            unit_file="$f"
            break
        fi
    done
    [ -n "$unit_file" ] || return 0

    exec_line=$(sed -n 's/^ExecStart=//p' "$unit_file" | head -n 1)
    # Strip systemd's special prefixes (-, @, +, !, :) from the command.
    exec_line=$(printf '%s' "$exec_line" | sed 's/^[-@:+!]*//')
    # Drop flags a previous revision of this package may have left behind.
    exec_line=$(printf '%s' "$exec_line" | sed 's/ *--test-quick-suspend-resume//g; s/ *--test-low-power-suspend-resume//g')

    [ -n "$exec_line" ] || return 0

    flags="--test-quick-suspend-resume"
    if mm_supports "--test-low-power-suspend-resume"; then
        flags="$flags --test-low-power-suspend-resume"
    fi

    if [ -f "$MM_DROPIN" ] && grep -qF -- "$flags" "$MM_DROPIN" 2>/dev/null; then
        return 0
    fi

    mkdir -p "$MM_DROPIN_DIR"
    {
        echo "# Installed by linux-apps (preinst).  Removed on purge."
        echo "# Do not edit; the package rewrites this file on every upgrade."
        echo "[Service]"
        echo "ExecStart="
        echo "ExecStart=${exec_line} ${flags}"
    } > "$MM_DROPIN"
    chmod 0644 "$MM_DROPIN"

    if have_systemctl; then
        systemctl daemon-reload 2>/dev/null || true
        systemctl try-restart ModemManager.service 2>/dev/null || true
    fi
    return 0
}

stop_services

# State file of the flash service; recreated on the next start.
rm -f /opt/rolling/rolling_flash_service/FwFlashSrv 2>/dev/null || true
rm -f /etc/opt/rolling/run/FwFlashSrv 2>/dev/null || true

remove_our_fcc_unlock
configure_modemmanager

exit 0
