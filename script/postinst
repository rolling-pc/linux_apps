#!/bin/sh
# postinst for linux-apps.
#
# SINGLE SOURCE OF TRUTH: the CPack build embeds script/<name> verbatim via
# CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA, and debian/<name> is a byte-for-byte copy
# of this file, so a cpack build and a dpkg-buildpackage build ship exactly the
# same maintainer scripts.  Edit here, then re-copy to debian/.
#
# No #DEBHELPER# token on purpose; see the note in script/preinst.
#
# upstream review 2026-11:
#  - systemd handling uses deb-systemd-helper / deb-systemd-invoke
#    (Policy 9.3.x) instead of raw systemctl; deb-systemd-invoke also
#    performs the daemon-reload for us.
#  - fcc-unlock helpers and the fwupd quirk ship as dpkg-owned real files
#    under /usr/share/rolling; only symlinks are created in the consuming
#    directories (ModemManager / fwupd), never copied content.

set -e

SERVICE_UNITS="rolling_helper rolling_config rolling_flash"
FCC_IDS="14c3:4d75 2cb7:01a2 2cb7:0301 413c:8209 413c:8211 413c:8213 413c:8215"
# dpkg-owned real files shipped by the package (staged by the "install"
# helper, see create_fcc_unlock / create_fwupd_quirk).
FCC_SRC_DIR="/usr/share/rolling/rolling_ma_service/fcc-unlock.d"
QUIRK_SRC="/usr/share/rolling/fwupd/quirks.d/rolling-linux-apps.quirk"
FWUPD_QUIRK_DIR="/usr/share/fwupd/quirks.d"
FWUPD_QUIRK_FILE="${FWUPD_QUIRK_DIR}/rolling-linux-apps.quirk"

case "$1" in
    configure)
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        exit 0
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

# The executables are shipped 0755; re-assert it in case an operator or an
# archive extraction dropped the bit.
fix_modes() {
    for f in /usr/bin/rolling_ma \
             /usr/lib/rolling/libmodemauth.so.1.1; do
        if [ -f "$f" ]; then
            chmod 0755 "$f"
        fi
    done
    return 0
}

# ModemManager loads FCC unlock plugins from its own directory.  The real
# scripts live under /usr/share/rolling (dpkg-managed); here we only create
# symlinks named after our modem IDs inside ModemManager's plugin directory.
# The symlink targets the /usr/share path so an upgrade of this
# package updates the behaviour without re-linking, and nothing owned by
# another package is copied or modified.
install_fcc_unlock() {
    [ -d "$FCC_SRC_DIR" ] || return 0

    for mm in /usr/lib/*/ModemManager /usr/lib/ModemManager /usr/lib64/ModemManager; do
        [ -d "$mm" ] || continue
        dest="${mm}/fcc-unlock.d"
        mkdir -p "$dest"
        for id in $FCC_IDS; do
            if [ -e "${FCC_SRC_DIR}/${id}" ]; then
                ln -sfn "${FCC_SRC_DIR}/${id}" "${dest}/${id}"
            fi
        done
    done
    return 0
}

# Seed /etc/rolling/config_file from the defaults shipped under
# /usr/share/rolling (dpkg-owned).  The destination is kept in sync with the
# runtime paths compiled into the binaries.
# An existing file in /etc is never overwritten, so local edits survive
# upgrades.
seed_config() {
    src="$1"
    dest="$2"
    [ -d "$src" ] || return 0
    for ini in "$src"/*.ini; do
        [ -f "$ini" ] || continue
        base=${ini##*/}
        mkdir -p "$dest"
        if [ ! -e "${dest}/${base}" ]; then
            cp -p "$ini" "${dest}/${base}"
        fi
    done
    return 0
}

# One-time migration from the legacy /etc/opt/rolling layout (binaries
# compiled before the /etc + /var/lib move): carry over operator-edited ini
# files so an upgrade does not lose local configuration.  The legacy tree is
# left in place; postrm purge removes it.
migrate_legacy_config() {
    svc="$1"
    legacy="/etc/opt/rolling/config_file/${svc}"
    dest="/etc/rolling/config_file/${svc}"
    [ -d "$legacy" ] || return 0
    mkdir -p "$dest"
    for ini in "$legacy"/*.ini; do
        [ -f "$ini" ] || continue
        base=${ini##*/}
        if [ ! -e "${dest}/${base}" ]; then
            cp -p "$ini" "${dest}/${base}"
        fi
    done
    return 0
}

# fwupd reads every *.quirk file in its quirks.d directory.  The real quirk
# file is shipped by this package under /usr/share/rolling; only the symlink
# in fwupd's (foreign) directory is created here.
install_fwupd_quirk() {
    [ -f "$QUIRK_SRC" ] || return 0
    [ -d "$FWUPD_QUIRK_DIR" ] || return 0

    ln -sfn "$QUIRK_SRC" "$FWUPD_QUIRK_FILE"

    if [ -d /run/systemd/system ]; then
        deb-systemd-invoke try-restart fwupd.service 2>/dev/null || true
    fi
    return 0
}

unit_file_present() {
    for dir in /lib/systemd/system /usr/lib/systemd/system; do
        if [ -f "${dir}/$1" ]; then
            return 0
        fi
    done
    return 1
}

# Enable and start the services with the debhelper-recommended tools
# (Policy 9.3.x, lintian maintainer-script-calls-systemctl).  deb-systemd-helper
# works without a running systemd (it maintains its own state files), so
# enable is unconditional; deb-systemd-invoke additionally handles
# daemon-reload and honours policy-rc.d, and is only called when systemd is
# actually running (chroot / container installs).
enable_services() {
    for unit in $SERVICE_UNITS; do
        if unit_file_present "${unit}.service"; then
            deb-systemd-helper unmask "${unit}.service" >/dev/null 2>&1 || true
            deb-systemd-helper enable "${unit}.service" >/dev/null 2>&1 || true
        fi
    done
    return 0
}

start_services() {
    [ -d /run/systemd/system ] || return 0
    units=""
    for unit in $SERVICE_UNITS; do
        if unit_file_present "${unit}.service"; then
            units="$units ${unit}.service"
        fi
    done
    [ -n "$units" ] || return 0

    if [ -n "$2" ]; then
        # upgrade: only restart if the units are already running
        deb-systemd-invoke try-restart $units 2>/dev/null || true
    else
        deb-systemd-invoke start $units 2>/dev/null || true
    fi
    return 0
}

fix_modes
install_fcc_unlock
migrate_legacy_config rolling_config_service
migrate_legacy_config rolling_flash_service
seed_config /usr/share/rolling/rolling_config_service /etc/rolling/config_file/rolling_config_service
seed_config /usr/share/rolling/rolling_flash_service /etc/rolling/config_file/rolling_flash_service

# Runtime state.  These paths are compiled into the binaries, so they must
# match exactly (persistent service state lives under /var/lib).
install -d -m 0755 /var/lib/rolling/run
install -d -m 0755 /var/lib/rolling/rolling_fw_pkg

install_fwupd_quirk
enable_services
start_services

exit 0
