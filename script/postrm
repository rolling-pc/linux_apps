#!/bin/sh
# postrm for linux-apps.
#
# SINGLE SOURCE OF TRUTH: the CPack build embeds script/<name> verbatim via
# CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA, and debian/<name> is a byte-for-byte copy
# of this file.  Edit here, then re-copy to debian/.
#
# No #DEBHELPER# token on purpose; see the note in script/preinst.
#
# upstream review 2026-11: enablement state is cleaned up with
# deb-systemd-helper (Policy 9.3.x) instead of raw systemctl; the fwupd quirk
# entry is now a symlink whose target is a dpkg-owned file under
# /usr/share/linux-apps.  Canonical review 2026-11: the ini files under
# /etc/rolling are dpkg conffiles (Policy 10.7), so dpkg removes them itself
# on purge; the rm -rf below only cleans runtime files and legacy trees.

set -e

SERVICE_UNITS="rolling_helper rolling_config rolling_flash"
FCC_IDS="14c3:4d75 2cb7:01a2 2cb7:0301 413c:8209 413c:8211 413c:8213 413c:8215"
MM_DROPIN="/etc/systemd/system/ModemManager.service.d/50-rolling-linux-apps.conf"
FWUPD_QUIRK_FILE="/usr/share/fwupd/quirks.d/rolling-linux-apps.quirk"

case "$1" in
    remove|purge)
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        exit 0
        ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

# Remove the files this package created outside its own payload: the FCC unlock
# symlinks in ModemManager's plugin directory, the fwupd quirk symlink and the
# ModemManager systemd drop-in.  Only our own file names are touched;
# directories and files belonging to other packages are left alone.
# (rm -f removes both the old plain copies and the current symlinks, so this
# also cleans up upgrades from pre-FHS revisions of the package.)
remove_runtime_files() {
    for mm in /usr/lib/*/ModemManager /usr/lib/ModemManager /usr/lib64/ModemManager; do
        [ -d "$mm" ] || continue
        for id in $FCC_IDS; do
            rm -f "${mm}/fcc-unlock.d/${id}" 2>/dev/null || true
        done
    done

    rm -f "$FWUPD_QUIRK_FILE" 2>/dev/null || true
    rm -f "$MM_DROPIN" 2>/dev/null || true
    rmdir /etc/systemd/system/ModemManager.service.d 2>/dev/null || true
    return 0
}

remove_runtime_files

# Configuration and runtime state are only removed on purge (Policy 6.5,
# 10.7.3).  A plain remove leaves /etc/rolling and /var/lib/rolling untouched
# so a later reinstall keeps the operator's settings.  deb-systemd-helper
# purge clears the enablement state without needing a running systemd.
#
# Legacy trees from pre-FHS revisions of this package are removed on purge:
#  - /etc/opt/rolling: ini config read by the old /opt-based binaries.
#  - /opt/rolling: the old binaries themselves.  They become unowned the
#    moment the new (/usr-based) package replaces the old one, so dpkg can
#    no longer remove them; leaving them behind makes systemd re-execute a
#    stale binary if a stale unit definition survives in the manager
#    (observed: rolling_flash SEGV loop from /opt after purge+reinstall).
if [ "$1" = "purge" ]; then
    for unit in $SERVICE_UNITS; do
        deb-systemd-helper purge "${unit}.service" 2>/dev/null || true
    done
    rm -rf /etc/rolling
    rm -rf /var/lib/rolling
    rm -rf /etc/opt/rolling
    rm -rf /opt/rolling
fi

exit 0
