#
# prerm for linux-apps.
#
# SINGLE SOURCE OF TRUTH: the CPack build embeds script/<name> verbatim via
# CPACK_DEBIAN_PACKAGE_CONTROL_EXTRA, and debian/<name> is a byte-for-byte copy
# of this file.  Edit here, then re-copy to debian/.
#
# No #DEBHELPER# token on purpose; see the note in script/preinst.
#
# upstream review 2026-11: systemd calls use deb-systemd-helper /
# deb-systemd-invoke (Policy 9.3.x) instead of raw systemctl.

set -e

# rolling_seed_config is included so its enablement symlinks are cleaned up
# on remove, like the long-running services.
SERVICE_UNITS="rolling_helper rolling_config rolling_flash rolling_seed_config"

case "$1" in
    remove)
        ;;
    upgrade|deconfigure)
        ;;
    failed-upgrade)
        # The new package failed to configure; stay out of the way.
        exit 0
        ;;
    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

service_units_present() {
    found=""
    for unit in $SERVICE_UNITS; do
        for dir in /lib/systemd/system /usr/lib/systemd/system; do
            if [ -f "${dir}/${unit}.service" ]; then
                found="$found ${unit}.service"
                break
            fi
        done
    done
    printf '%s' "$found"
}

# Stop before the binaries disappear.  Never disable on upgrade: the postinst of
# the new version enables the units again, and disabling here would briefly drop
# the WantedBy symlinks for no benefit.
# deb-systemd-invoke honours policy-rc.d and handles daemon-reload; it is only
# called when systemd is actually running (chroot / container installs).
units=$(service_units_present)
if [ -d /run/systemd/system ] && [ -n "$units" ]; then
    deb-systemd-invoke stop $units 2>/dev/null || true
fi

if [ "$1" = "remove" ]; then
    # deb-systemd-helper works without a running systemd: it only maintains
    # its own enablement state and the WantedBy symlinks.
    [ -n "$units" ] && deb-systemd-helper disable $units 2>/dev/null || true
fi

exit 0
