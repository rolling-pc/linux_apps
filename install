basedir=`cd \`dirname $0\`; pwd`
BUILD_DIR=${basedir}/build
# Binary-only tree: the prebuilt executables live in the source tree, not in
# the build output.
APP_DIR="${basedir}/application"
CONFIG_SERVICE_APP_DIR="${APP_DIR}/rolling_config_service"
CONFIG_SERVICE_APP_PATH="${APP_DIR}/rolling_config_service/rolling_config"
FLASH_SERVICE_APP_PATH="${APP_DIR}/rolling_flash_service/rolling_flash"
FLASH_SERVICE_APP_DIR="${APP_DIR}/rolling_flash_service"
MA_SERVICE_COMMON_LIB="${basedir}/binary_deb/common_lib"
# rolling_ma ships as a prebuilt binary next to its (unpublished) sources.
# The CMake build output is preferred when the sources are ever added.
MA_SERVICE_PATH_APP_DIR="${basedir}/application/rolling_ma_service"
MA_SERVICE_PATH_APP_PATH="${BUILD_DIR}/application/rolling_ma_service/rolling_ma"

function resolve_rolling_ma_source()
{
    local candidate=""
    local distro_tag=""

    if [ -f "${BUILD_DIR}/CMakeCache.txt" ]; then
        distro_tag=$(grep -E '^DISTRO_TAG:STRING=' "${BUILD_DIR}/CMakeCache.txt" 2>/dev/null | cut -d= -f2)
    fi

    # Precedence: a real build from source wins; then a distro-specific prebuilt
    # (multi-distro builds may need a different libc/ABI); then the generic
    # prebuilt shipped with the service; then the historical binary_deb/ copy.
    if [ -f "${MA_SERVICE_PATH_APP_PATH}" ]; then
        candidate="${MA_SERVICE_PATH_APP_PATH}"
    elif [ -n "${distro_tag}" ] && [ -f "${basedir}/binary_deb/common_lib-${distro_tag}/rolling_ma" ]; then
        candidate="${basedir}/binary_deb/common_lib-${distro_tag}/rolling_ma"
    elif [ -f "${MA_SERVICE_PATH_APP_DIR}/rolling_ma" ]; then
        candidate="${MA_SERVICE_PATH_APP_DIR}/rolling_ma"
    elif [ -f "${MA_SERVICE_COMMON_LIB}/rolling_ma" ]; then
        candidate="${MA_SERVICE_COMMON_LIB}/rolling_ma"
    fi

    if [ -z "${candidate}" ]; then
        echo "ERROR: rolling_ma not found for deb packaging." >&2
        echo "  expected build output:  ${MA_SERVICE_PATH_APP_PATH}" >&2
        echo "  expected prebuilt file: ${MA_SERVICE_PATH_APP_DIR}/rolling_ma" >&2
        if [ -n "${distro_tag}" ]; then
            echo "  expected versioned lib: ${basedir}/binary_deb/common_lib-${distro_tag}/rolling_ma" >&2
        fi
        echo "  expected common lib: ${MA_SERVICE_COMMON_LIB}/rolling_ma" >&2
        echo "  sync matching Ubuntu rolling_ma from opensrc Docker lib build." >&2
        exit 1
    fi

    echo "${candidate}"
}


# FHS 3.13 / Debian Policy 9.1.1 (upstream review 2026-11): Debian packages
# must not install under /opt.  Binaries go to /usr/bin, OEM-specific
# binaries and shared libraries to /usr/lib/rolling, and
# architecture-independent runtime data (fcc-unlock helpers, fwupd quirk,
# ini templates) to /usr/share/<package>/ (Canonical review 2026-11: the
# directory must be the package name, cf. /usr/share/pipewire).
#
# Universal package (single package per project, 2026-11): one deb covers
# every OEM.  OEM-specific assets are ALL shipped and selected at runtime:
#   - rolling_helper variants live under
#     /usr/lib/rolling/rolling_helper_service/helper_set/<project>_<oem>/;
#     /usr/bin/rolling_helper is a generated DMI-dispatch wrapper that execs
#     the variant matching the machine vendor.
#   - ini files ship as templates under
#     /usr/share/linux-apps/{config,flash}_set/<project>_<oem>/ and are
#     seeded into /etc/rolling/config_file by seed_config.sh (postinst
#     best-effort + rolling_seed_config.service oneshot at first boot).
#     They are NOT dpkg conffiles in this layout; seeding never overwrites
#     an existing file, so operator edits survive upgrades.
DEB_SOFT_DIRS="${BUILD_DIR}/release/dpkg"
DEB_BIN_DIR="${DEB_SOFT_DIRS}/usr/bin"
DEB_SHARE_DIR="${DEB_SOFT_DIRS}/usr/share/linux-apps"
DEB_LIB_ROLLING_DIR="${DEB_SOFT_DIRS}/usr/lib/rolling"
# NOTE (Debian UpstreamGuide): third-party shared libraries (libxml2,
# glib, fwupd, mbim, udev, ...) are NOT bundled here -- they are
# resolved from the system at run time via the declared package
# dependencies (see CPACK_DEBIAN_PACKAGE_DEPENDS in CMakeLists.txt).
DEB_MA_SERVICE_DIR="${DEB_SHARE_DIR}/rolling_ma_service"
# Source tree locations of the OEM-specific assets.
HELPER_SET_DIR="${APP_DIR}/rolling_helper_service/helper_set"

OEMUSBID_LIST=( 14c3:4d75 2cb7:01a2 2cb7:0301 413c:8209 413c:8211 413c:8213 413c:8215 )



BUILD_HELPER=$(grep -o 'set(BUILD_HELPER "[^"]*"' ${BUILD_DIR}/*_config.cmake | awk -F'"' '{print $2}')
BUILD_DOWN_TOOL=$(grep -o 'set(BUILD_DOWN_TOOL "[^"]*"' ${BUILD_DIR}/*_config.cmake | awk -F'"' '{print $2}')
BUILD_FLASH=$(grep -o 'set(BUILD_FLASH "[^"]*"' ${BUILD_DIR}/*_config.cmake | awk -F'"' '{print $2}')
BUILD_CONFIG=$(grep -o 'set(BUILD_CONFIG "[^"]*"' ${BUILD_DIR}/*_config.cmake | awk -F'"' '{print $2}')
BUILD_MA=$(grep -o 'set(BUILD_MA "[^"]*"' ${BUILD_DIR}/*_config.cmake | awk -F'"' '{print $2}')
OEM_BUILD=$(grep -o 'set(OEM_BUILD "[^"]*"' ${BUILD_DIR}/*_config.cmake | awk -F'"' '{print $2}')
PROJECT_BUILD=$(grep -o 'set(PROJECT_BUILD "[^"]*"' ${BUILD_DIR}/*_config.cmake | awk -F'"' '{print $2}')
# All OEM sections of <project>_config (emitted by cmake_config).  The
# universal package stages the assets of every section.
OEM_SECTIONS=$(grep -o 'set(OEM_SECTIONS "[^"]*"' ${BUILD_DIR}/*_config.cmake | awk -F'"' '{print $2}')
[ -n "${OEM_SECTIONS}" ] || OEM_SECTIONS="${OEM_BUILD}"
echo "OEM_BUILD: ${OEM_BUILD}"
echo "PROJECT_BUILD: ${PROJECT_BUILD}"
echo "OEM_SECTIONS: ${OEM_SECTIONS}"

echo "build helper package ${BUILD_HELPER}"
echo "build down tool package ${BUILD_DOWN_TOOL}"
echo "build flash package ${BUILD_FLASH}"
echo "build config package ${BUILD_CONFIG}"
echo "build ma package ${BUILD_MA}"



function operation_menu_select()
{
    echo -e "\033[32m=================================================== \033[0m"
    echo -e "\033[35m operation select:\033[0m"
    for list in ${BUILD_LIST[@]}; do
        echo -e "\033[32m    --------------------------------- \033[0m"
        COUNT=$(($COUNT+1)); echo -e "\033[35m    $COUNT.$list \033[0m"
    done
}

# DMI sys_vendor patterns per OEM name.  Used by the generated helper
# dispatcher and the generated seed_config.sh to pick the OEM-specific
# assets at runtime.  An OEM without a known DMI pattern contributes no
# case arm (unknown-vendor machines then fail loudly instead of running a
# wrong-OEM helper).
function oem_dmi_pattern()
{
    case "$1" in
        dell)   echo "Dell*" ;;
        lenovo) echo "LENOVO*" ;;
        hp)     echo "HP*" ;;
        *)      echo "" ;;
    esac
}

# 修改copy_file_to_deb_directory函数
function copy_file_to_deb_directory()
{
    mkdir -p ${DEB_BIN_DIR}

    if [ "yes" == "${BUILD_CONFIG}" ]; then
        # binary -> /usr/bin, ini templates -> /usr/share/linux-apps/config_set/
        # The matching set is seeded into /etc/rolling/config_file at runtime
        # by seed_config.sh (DMI-detected OEM); no /etc staging here.
        cp -fraf ${CONFIG_SERVICE_APP_PATH} ${DEB_BIN_DIR} 2>/dev/null || true
        for oem in ${OEM_SECTIONS}; do
            src="${CONFIG_SERVICE_APP_DIR}/config_set/${PROJECT_BUILD}_${oem}"
            if [ -d "${src}" ]; then
                mkdir -p ${DEB_SHARE_DIR}/config_set/${PROJECT_BUILD}_${oem}
                cp -f ${src}/*.ini ${DEB_SHARE_DIR}/config_set/${PROJECT_BUILD}_${oem}/
            else
                echo "ERROR: config_set missing for ${PROJECT_BUILD}_${oem}: ${src}" >&2
                exit 1
            fi
        done
    fi

    if [ "yes" == "${BUILD_FLASH}" ]; then
        # binary -> /usr/bin, ini templates -> /usr/share/linux-apps/flash_set/
        cp -fraf ${FLASH_SERVICE_APP_PATH} ${DEB_BIN_DIR} 2>/dev/null || true
        for oem in ${OEM_SECTIONS}; do
            src="${FLASH_SERVICE_APP_DIR}/flash_set/${PROJECT_BUILD}_${oem}"
            if [ -d "${src}" ]; then
                mkdir -p ${DEB_SHARE_DIR}/flash_set/${PROJECT_BUILD}_${oem}
                cp -f ${src}/*.ini ${DEB_SHARE_DIR}/flash_set/${PROJECT_BUILD}_${oem}/
            else
                echo "ERROR: flash_set missing for ${PROJECT_BUILD}_${oem}: ${src}" >&2
                exit 1
            fi
        done
    fi

    if [ "yes" == "${BUILD_HELPER}" ]; then
        # Universal package: every OEM's helper binary ships under
        # /usr/lib/rolling/rolling_helper_service/helper_set/<project>_<oem>/
        # and /usr/bin/rolling_helper is a generated DMI-dispatch wrapper.
        # A missing variant is a packaging error: the wrapper would have no
        # binary to exec for that OEM.
        mkdir -p ${DEB_LIB_ROLLING_DIR}/rolling_helper_service/helper_set
        for oem in ${OEM_SECTIONS}; do
            variant="${HELPER_SET_DIR}/${PROJECT_BUILD}_${oem}/rolling_helper"
            if [ -f "${variant}" ]; then
                dest_dir="${DEB_LIB_ROLLING_DIR}/rolling_helper_service/helper_set/${PROJECT_BUILD}_${oem}"
                mkdir -p ${dest_dir}
                cp -f ${variant} ${dest_dir}/rolling_helper
                chmod 755 ${dest_dir}/rolling_helper
                echo "packaged rolling_helper variant ${PROJECT_BUILD}_${oem}"
            else
                echo "ERROR: rolling_helper variant missing: ${variant}" >&2
                exit 1
            fi
        done
        create_helper_dispatcher ${DEB_BIN_DIR}/rolling_helper
    fi

    if [ "yes" == "${BUILD_MA}" ]; then
        mkdir -p ${DEB_MA_SERVICE_DIR}/fcc-unlock.d
        # FCC unlock backend ships for Dell machines only; Lenovo machines
        # are unlocked by an external vendor tool and do not use this
        # backend.  The generated fcc-unlock scripts dispatch on the DMI
        # vendor and run rolling_ma on Dell machines.
        mkdir -p ${DEB_LIB_ROLLING_DIR}
        rolling_ma_src=$(resolve_rolling_ma_source)
        cp -f "${rolling_ma_src}" ${DEB_BIN_DIR}/rolling_ma
        chmod 755 ${DEB_BIN_DIR}/rolling_ma
        echo "packaged rolling_ma from ${rolling_ma_src}"
        create_fcc_unlock ${DEB_MA_SERVICE_DIR}/fcc-unlock.d
    fi

    # NOTE: no third-party library staging and no RUNPATH rewriting here;
    # the binaries load the system copies via the declared package
    # dependencies (Debian UpstreamGuide: do not bundle third-party
    # code, do not modify files at install time).
}

# Generate /usr/bin/rolling_helper as a DMI-dispatch wrapper.  systemd keeps
# running this path (Type=simple, Restart=on-abort, ExecReload=kill -HUP all
# still apply); exec replaces the shell so signals reach the real binary.
# Unknown vendors exit non-zero: silently running a wrong-OEM helper on the
# flash/config path is worse than a clear "service failed" in the journal.
function create_helper_dispatcher()
{
    cat > "$1" <<DISPATCH_EOF
#!/bin/sh
# OEM dispatcher for rolling_helper (auto-generated by the packaging install
# script; do not edit).  The rolling_helper binary is OEM-specific; the
# universal package ships every variant under
# /usr/lib/rolling/rolling_helper_service/helper_set/ and this wrapper execs
# the one matching the machine vendor (DMI).
HELPER_LIB_DIR=/usr/lib/rolling/rolling_helper_service/helper_set
vendor=\$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) || vendor=""
if [ -z "\$vendor" ]; then
    vendor=\$(cat /sys/class/dmi/id/board_vendor 2>/dev/null) || vendor=""
fi
case "\$vendor" in
DISPATCH_EOF
    for sec in ${OEM_SECTIONS}; do
        pattern=$(oem_dmi_pattern "${sec}")
        [ -n "${pattern}" ] || continue
        printf '    %s) exec "$HELPER_LIB_DIR/%s_%s/rolling_helper" "$@" ;;\n' \
            "${pattern}" "${PROJECT_BUILD}" "${sec}" >> "$1"
    done
    cat >> "$1" <<'DISPATCH_EOF'
    *)
        echo "rolling_helper: no packaged helper variant for DMI vendor '$vendor'" >&2
        exit 1 ;;
esac
DISPATCH_EOF
    chmod 755 "$1"
}

function create_helper_conf()
{
    echo "<!DOCTYPE busconfig PUBLIC
 \"-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN\"
 \"http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd\">
<busconfig>
  <!-- This config allows anyone to control mcdm -->

  <policy context=\"default\">
    <allow send_destination=\"com.rolling.helper\"/>
  </policy>

  <policy user=\"root\">
    <allow own=\"com.rolling.helper\"/>
  </policy>
</busconfig>" > $1/com.rolling.helper.conf
    chmod 644 $1/com.rolling.helper.conf
}

function create_config_service()
{
    echo "[Unit]
Description=Firmware Config Service
Documentation=https://github.com/rolling-pc/linux_apps
After=ModemManager.service rolling_helper.service

[Service]
# FHS 2026-11 review: do not ship config files under /usr.  The single
# LD_LIBRARY_PATH=...:/usr/local/lib line that used to live in the
# rolling_config.d/env.conf drop-in is inlined here as a plain Environment=
# directive, so the whole drop-in directory can be removed.
Environment="LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/lib"
ExecStart=/usr/bin/rolling_config
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-abort
Type=simple
User=root

# Hardening (systemd-service-file-missing-hardening-features, Policy pedantic).
# Safe subset: none of these services touch /home, /tmp (except via the D-Bus
# peers), the clock, hostname, kernel logs/modules/tunables, cgroups, and they
# do not create SUID/SGID files (verified against the application sources).
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
Alias=rolling_config.service
WantedBy=multi-user.target" > $1/rolling_config.service
    chmod 644 $1/rolling_config.service
}

function create_flash_service()
{
    echo "[Unit]
Description=Firmware Flash Service
Documentation=https://github.com/rolling-pc/linux_apps
After=ModemManager.service rolling_helper.service
[Service]
# FHS 2026-11 review: same rationale as rolling_config.service -- inline
# Environment= removes the rolling_flash.d/env.conf drop-in.
Environment="LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/lib"
ExecStart=/usr/bin/rolling_flash
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-abort
Type=simple
User=root

# Same safe hardening subset as rolling_config.service; firmware payloads are
# consumed from /var/lib/rolling/rolling_fw_pkg, never /tmp or /sys.
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
Alias=rolling_flash.service
WantedBy=multi-user.target" > $1/rolling_flash.service
    chmod 644 $1/rolling_flash.service

}

