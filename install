#! /bin/bash

basedir=`cd \`dirname $0\`; pwd`
BUILD_DIR=${basedir}/build
# Binary-only tree: the prebuilt executables live in the source tree, not in
# the build output.
APP_DIR="${basedir}/application"
CONFIG_SERVICE_APP_DIR="${APP_DIR}/rolling_config_service"
CONFIG_SERVICE_APP_PATH="${APP_DIR}/rolling_config_service/rolling_config"
FLASH_SERVICE_APP_PATH="${APP_DIR}/rolling_flash_service/rolling_flash"
FLASH_SERVICE_APP_DIR="${APP_DIR}/rolling_flash_service"
HELPER_SERVICE_APP_PATH="${APP_DIR}/rolling_helper_service/"
MA_SERVICE_COMMON_LIB="${basedir}/binary_deb/common_lib"
# rolling_ma ships as a prebuilt binary next to its (unpublished) sources.
# The CMake build output is preferred when the sources are ever added.
MA_SERVICE_PATH_APP_DIR="${basedir}/application/rolling_ma_service"
MA_SERVICE_PATH_APP_PATH="${BUILD_DIR}/application/rolling_ma_service/rolling_ma"

function resolve_rolling_ma_source()
{
    local candidate=""
    local distro_tag=""

    if [ -f "${BUILD_DIR}/CMakeCache.txt" ]; then
        distro_tag=$(grep -E '^DISTRO_TAG:STRING=' "${BUILD_DIR}/CMakeCache.txt" 2>/dev/null | cut -d= -f2)
    fi

    # Precedence: a real build from source wins; then a distro-specific prebuilt
    # (multi-distro builds may need a different libc/ABI); then the generic
    # prebuilt shipped with the service; then the historical binary_deb/ copy.
    if [ -f "${MA_SERVICE_PATH_APP_PATH}" ]; then
        candidate="${MA_SERVICE_PATH_APP_PATH}"
    elif [ -n "${distro_tag}" ] && [ -f "${basedir}/binary_deb/common_lib-${distro_tag}/rolling_ma" ]; then
        candidate="${basedir}/binary_deb/common_lib-${distro_tag}/rolling_ma"
    elif [ -f "${MA_SERVICE_PATH_APP_DIR}/rolling_ma" ]; then
        candidate="${MA_SERVICE_PATH_APP_DIR}/rolling_ma"
    elif [ -f "${MA_SERVICE_COMMON_LIB}/rolling_ma" ]; then
        candidate="${MA_SERVICE_COMMON_LIB}/rolling_ma"
    fi

    if [ -z "${candidate}" ]; then
        echo "ERROR: rolling_ma not found for deb packaging." >&2
        echo "  expected build output:  ${MA_SERVICE_PATH_APP_PATH}" >&2
        echo "  expected prebuilt file: ${MA_SERVICE_PATH_APP_DIR}/rolling_ma" >&2
        if [ -n "${distro_tag}" ]; then
            echo "  expected versioned lib: ${basedir}/binary_deb/common_lib-${distro_tag}/rolling_ma" >&2
        fi
        echo "  expected common lib: ${MA_SERVICE_COMMON_LIB}/rolling_ma" >&2
        echo "  sync matching Ubuntu rolling_ma from opensrc Docker lib build." >&2
        exit 1
    fi

    echo "${candidate}"
}


# FHS 3.13 / Debian Policy 9.1.1 (upstream review 2026-11): Debian packages
# must not install under /opt.  Binaries go to /usr/bin, architecture-independent
# runtime data (ini defaults, fcc-unlock helpers) to /usr/share/rolling, and the
# lenovo-only shared library to /usr/lib/rolling.
DEB_SOFT_DIRS="${BUILD_DIR}/release/dpkg"
DEB_BIN_DIR="${DEB_SOFT_DIRS}/usr/bin"
DEB_SHARE_DIR="${DEB_SOFT_DIRS}/usr/share/rolling"
DEB_LIB_ROLLING_DIR="${DEB_SOFT_DIRS}/usr/lib/rolling"
DEB_CONFIG_SERVICE_DIR="${DEB_SHARE_DIR}/rolling_config_service"
DEB_FLASH_SERVICE_DIR="${DEB_SHARE_DIR}/rolling_flash_service"
DEB_MA_SERVICE_DIR="${DEB_SHARE_DIR}/rolling_ma_service"

OEMUSBID_LIST=( 14c3:4d75 2cb7:01a2 2cb7:0301 413c:8209 413c:8211 413c:8213 413c:8215 )



BUILD_HELPER=$(grep -o 'set(BUILD_HELPER "[^"]*"' ${BUILD_DIR}/*_config.cmake | awk -F'"' '{print $2}')
BUILD_DOWN_TOOL=$(grep -o 'set(BUILD_DOWN_TOOL "[^"]*"' ${BUILD_DIR}/*_config.cmake | awk -F'"' '{print $2}')
BUILD_FLASH=$(grep -o 'set(BUILD_FLASH "[^"]*"' ${BUILD_DIR}/*_config.cmake | awk -F'"' '{print $2}')
BUILD_CONFIG=$(grep -o 'set(BUILD_CONFIG "[^"]*"' ${BUILD_DIR}/*_config.cmake | awk -F'"' '{print $2}')
BUILD_MA=$(grep -o 'set(BUILD_MA "[^"]*"' ${BUILD_DIR}/*_config.cmake | awk -F'"' '{print $2}')
OEM_BUILD=$(grep -o 'set(OEM_BUILD "[^"]*"' ${BUILD_DIR}/*_config.cmake | awk -F'"' '{print $2}')
PROJECT_BUILD=$(grep -o 'set(PROJECT_BUILD "[^"]*"' ${BUILD_DIR}/*_config.cmake | awk -F'"' '{print $2}')
echo "OEM_BUILD: ${OEM_BUILD}"
echo "PROJECT_BUILD: ${PROJECT_BUILD}"

echo "build helper package ${BUILD_HELPER}"
echo "build down tool package ${BUILD_DOWN_TOOL}"
echo "build flash package ${BUILD_FLASH}"
echo "build config package ${BUILD_CONFIG}"
echo "build ma package ${BUILD_MA}"



function operation_menu_select()
{
    echo -e "\033[32m=================================================== \033[0m"
    echo -e "\033[35m operation select:\033[0m"
    for list in ${BUILD_LIST[@]}; do
        echo -e "\033[32m    --------------------------------- \033[0m"
        COUNT=$(($COUNT+1)); echo -e "\033[35m    $COUNT.$list \033[0m"
    done
}

# 修改copy_file_to_deb_directory函数
function copy_file_to_deb_directory()
{
    # copy configservice file
    if [ "$(ls -A $DEB_CONFIG_SERVICE_DIR)" ]; then
        rm -r ${DEB_CONFIG_SERVICE_DIR}/*
    fi
    if [ "$(ls -A $DEB_FLASH_SERVICE_DIR)" ]; then
        rm -r ${DEB_FLASH_SERVICE_DIR}/*
    fi
    mkdir -p ${DEB_BIN_DIR}

    if [ "yes" == "${BUILD_CONFIG}" ]; then
        # binary -> /usr/bin, ini defaults -> /usr/share/rolling/<service>/
        cp -fraf ${CONFIG_SERVICE_APP_PATH} ${DEB_BIN_DIR} 2>/dev/null || true
        # runtime config data, selected per OEM from config_set/<project>_<oem>/
        cp -f ${CONFIG_SERVICE_APP_DIR}/config_set/${PROJECT_BUILD}_${OEM_BUILD}/*.ini ${DEB_CONFIG_SERVICE_DIR}/ 2>/dev/null || true
    fi

    if [ "yes" == "${BUILD_FLASH}" ]; then
        DEB_FLASH_SERVICE_DIR="${DEB_SHARE_DIR}/rolling_flash_service"
        # binary -> /usr/bin, ini defaults -> /usr/share/rolling/<service>/
        cp -fraf ${FLASH_SERVICE_APP_PATH} ${DEB_BIN_DIR} 2>/dev/null || true
        # runtime config data, selected per OEM from flash_set/<project>_<oem>/
        cp -f ${FLASH_SERVICE_APP_DIR}/flash_set/${PROJECT_BUILD}_${OEM_BUILD}/*.ini ${DEB_FLASH_SERVICE_DIR}/ 2>/dev/null || true
    fi

    if [ "yes" == "${BUILD_HELPER}" ]; then
        # single prebuilt binary -> /usr/bin/rolling_helper
        cp -fraf ${HELPER_SERVICE_APP_PATH}/*rolling_helper ${DEB_BIN_DIR} 2>/dev/null || true
        # 确保实际二进制文件被重命名为rolling_helper
        for bin_file in ${DEB_BIN_DIR}/*rolling_helper; do
            if [ -f "$bin_file" ] && [ "$bin_file" != "${DEB_BIN_DIR}/rolling_helper" ]; then
                mv "$bin_file" "${DEB_BIN_DIR}/rolling_helper"
                break
            fi
        done
    fi

    if [ "yes" == "${BUILD_MA}" ]; then
        mkdir -p ${DEB_MA_SERVICE_DIR}/fcc-unlock.d
        if [ "lenovo" == "${OEM_BUILD}" ]; then
            mkdir -p ${DEB_LIB_ROLLING_DIR}
            cp -f ${MA_SERVICE_COMMON_LIB}/libmodemauth.so.1.1 ${DEB_LIB_ROLLING_DIR}/
            chmod 755 ${DEB_LIB_ROLLING_DIR}/libmodemauth.so.1.1
        else
            rolling_ma_src=$(resolve_rolling_ma_source)
            cp -f "${rolling_ma_src}" ${DEB_BIN_DIR}/rolling_ma
            chmod 755 ${DEB_BIN_DIR}/rolling_ma
            echo "packaged rolling_ma from ${rolling_ma_src}"
        fi
        create_fcc_unlock ${DEB_MA_SERVICE_DIR}/fcc-unlock.d
    fi
}

function create_helper_conf()
{
    echo "<!DOCTYPE busconfig PUBLIC
 \"-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN\"
 \"http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd\">
<busconfig>
  <!-- This config allows anyone to control mcdm -->

  <policy context=\"default\">
    <allow send_destination=\"com.rolling.helper\"/>
  </policy>

  <policy user=\"root\">
    <allow own=\"com.rolling.helper\"/>
  </policy>
</busconfig>" > $1/com.rolling.helper.conf
    chmod 644 $1/com.rolling.helper.conf
}

function create_config_service()
{
    echo "[Unit]
Description=Firmware Config Service
Documentation=https://github.com/rolling-pc/linux_apps
After=ModemManager.service rolling_helper.service

[Service]
WorkingDirectory=/usr/share/rolling/rolling_config_service
EnvironmentFile=/usr/lib/systemd/system/rolling_config.d/env.conf
ExecStart=/usr/bin/rolling_config
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-abort
Type=simple
User=root

# Hardening (systemd-service-file-missing-hardening-features, Policy pedantic).
# Safe subset: none of these services touch /home, /tmp (except via the D-Bus
# peers), the clock, hostname, kernel logs/modules/tunables, cgroups, and they
# do not create SUID/SGID files (verified against the application sources).
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
Alias=rolling_config.service
WantedBy=multi-user.target" > $1/rolling_config.service
    chmod 644 $1/rolling_config.service
}

function create_flash_service()
{
    echo "[Unit]
Description=Firmware Flash Service
Documentation=https://github.com/rolling-pc/linux_apps
After=ModemManager.service rolling_helper.service
[Service]
WorkingDirectory=/usr/share/rolling/rolling_flash_service
EnvironmentFile=/usr/lib/systemd/system/rolling_flash.d/env.conf
ExecStart=/usr/bin/rolling_flash
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-abort
Type=simple
User=root

# Same safe hardening subset as rolling_config.service; firmware payloads are
# consumed from /var/lib/rolling/rolling_fw_pkg, never /tmp or /sys.
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
Alias=rolling_flash.service
WantedBy=multi-user.target" > $1/rolling_flash.service
    chmod 644 $1/rolling_flash.service

}

function create_helper_service()
{
    echo "[Unit]
Description=Firmware Helper Service
Documentation=https://github.com/rolling-pc/linux_apps
After=ModemManager.service

[Service]
EnvironmentFile=/usr/lib/systemd/system/rolling_helper.d/env.conf
ExecStart=/usr/bin/rolling_helper
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-abort
Type=simple
User=root

# Same safe hardening subset as rolling_config.service.
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
Alias=rolling_helper.service
WantedBy=multi-user.target" > $1/rolling_helper.service
    chmod 644 $1/rolling_helper.service

}

function create_config_d()
{
    echo "LD_LIBRARY_PATH=\$LD_LIBRARY_PATH:/usr/local/lib" > $1/env.conf
    chmod 644 $1/env.conf

}

function create_flash_d()
{
    echo "LD_LIBRARY_PATH=\$LD_LIBRARY_PATH:/usr/local/lib" > $1/env.conf
    chmod 644 $1/env.conf

}
function create_helper_d()
{
    echo "LD_LIBRARY_PATH=\$LD_LIBRARY_PATH:/usr/local/lib" > $1/env.conf
    chmod 644 $1/env.conf

}

function create_rule()
{
    echo "# do not edit this file, it will be overwritten on update
ACTION!=\"add|change|move|bind\", GOTO=\"mm_rolling_linux_apps_port_types_end\"
SUBSYSTEMS==\"pci\", SUBSYSTEM==\"wwan\", ATTRS{vendor}==\"0x14c3\", GOTO=\"mm_rw350_port_types\"
SUBSYSTEMS==\"usb\", ATTRS{bInterfaceNumber}==\"?*\", ENV{.MM_USBIFNUM}=\"\$attr{bInterfaceNumber}\", GOTO=\"mm_rw101_port_types\"
GOTO=\"mm_rolling_linux_apps_port_types_end\"

LABEL=\"mm_rw350_port_types\"
ATTRS{vendor}==\"0x14c3\", ATTRS{device}==\"0x4d75\", ATTR{type}==\"FASTBOOT\", ENV{ID_MM_PORT_IGNORE}=\"1\"
GOTO=\"mm_rolling_linux_apps_port_types_end\"

LABEL=\"mm_rw101_port_types\"
ATTRS{idVendor}==\"2cb7\", ATTRS{idProduct}==\"01a2\", ENV{.MM_USBIFNUM}==\"02\", SUBSYSTEM==\"tty\", ENV{ID_MM_PORT_IGNORE}=\"1\"
ATTRS{idVendor}==\"2cb7\", ATTRS{idProduct}==\"01a2\", ENV{.MM_USBIFNUM}==\"03\", SUBSYSTEM==\"tty\", ENV{ID_MM_PORT_IGNORE}=\"1\"
ATTRS{idVendor}==\"2cb7\", ATTRS{idProduct}==\"01a2\", ENV{.MM_USBIFNUM}==\"04\", ENV{ID_MM_PORT_IGNORE}=\"1\"
ATTRS{idVendor}==\"2cb7\", ATTRS{idProduct}==\"01a2\", ENV{.MM_USBIFNUM}==\"05\", ENV{ID_MM_PORT_IGNORE}=\"1\"

ATTRS{idVendor}==\"413c\", ATTRS{idProduct}==\"8213\", ENV{.MM_USBIFNUM}==\"02\", SUBSYSTEM==\"tty\", ENV{ID_MM_PORT_IGNORE}=\"1\"
ATTRS{idVendor}==\"413c\", ATTRS{idProduct}==\"8215\", ENV{.MM_USBIFNUM}==\"02\", SUBSYSTEM==\"tty\", ENV{ID_MM_PORT_IGNORE}=\"1\"

LABEL=\"mm_rolling_linux_apps_port_types_end\"
" > $1/76-mm-rolling-linux-apps-port-types.rules
    chmod 644 $1/76-mm-rolling-linux-apps-port-types.rules
}
function create_lvfs_rule()
{
    echo "# do not edit this file, it will be overwritten on update
ACTION!=\"add|change|move|bind\", GOTO=\"mm_rolling_linux_apps_port_types_end\"
SUBSYSTEMS==\"usb\", ATTRS{bInterfaceNumber}==\"?*\", ENV{.MM_USBIFNUM}=\"\$attr{bInterfaceNumber}\", GOTO=\"mm_rw101_port_types\"
GOTO=\"mm_rolling_linux_apps_port_types_end\"

LABEL=\"mm_rw101_port_types\"

ATTRS{idVendor}==\"33f8\", ATTRS{idProduct}==\"0301\",\
RUN+=\"/bin/sh -c '/sbin/modprobe usbserial && /sbin/modprobe option && echo 33f8 0301 ff > /sys/bus/usb-serial/drivers/option1/new_id'\"

ATTRS{idVendor}==\"33f8\", ATTRS{idProduct}==\"0302\",\
RUN+=\"/bin/sh -c '/sbin/modprobe usbserial && /sbin/modprobe option && echo 33f8 0302 ff > /sys/bus/usb-serial/drivers/option1/new_id'\"

ATTRS{idVendor}==\"33f8\", ATTRS{idProduct}==\"01a8\",\
RUN+=\"/bin/sh -c '/sbin/modprobe usbserial && /sbin/modprobe option && echo 33f8 01a8 ff > /sys/bus/usb-serial/drivers/option1/new_id'\"

ATTRS{idVendor}==\"33f8\", ATTRS{idProduct}==\"01a9\",\
RUN+=\"/bin/sh -c '/sbin/modprobe usbserial && /sbin/modprobe option && echo 33f8 01a9 ff > /sys/bus/usb-serial/drivers/option1/new_id'\"

ATTRS{idVendor}==\"33f8\", ATTRS{idProduct}==\"0301\", ENV{.MM_USBIFNUM}==\"02\", SUBSYSTEM==\"tty\", ENV{ID_MM_PORT_TYPE_AT_PRIMARY}=\"1\"
ATTRS{idVendor}==\"33f8\", ATTRS{idProduct}==\"0302\", ENV{.MM_USBIFNUM}==\"02\", SUBSYSTEM==\"tty\", ENV{ID_MM_PORT_TYPE_AT_PRIMARY}=\"1\"
ATTRS{idVendor}==\"33f8\", ATTRS{idProduct}==\"0301\", ENV{.MM_USBIFNUM}==\"02\", SUBSYSTEM==\"tty\", ENV{ID_MM_FIBOCOM_FASTBOOT}=\"1\"
ATTRS{idVendor}==\"33f8\", ATTRS{idProduct}==\"0301\", ENV{.MM_USBIFNUM}==\"02\", SUBSYSTEM==\"tty\", ENV{ID_MM_PORT_TYPE_GPS}=\"0\"
ATTRS{idVendor}==\"33f8\", ATTRS{idProduct}==\"0302\", ENV{.MM_USBIFNUM}==\"02\", SUBSYSTEM==\"tty\", ENV{ID_MM_FIBOCOM_FASTBOOT}=\"1\"
ATTRS{idVendor}==\"33f8\", ATTRS{idProduct}==\"01a8\", ENV{.MM_USBIFNUM}==\"03\", SUBSYSTEM==\"tty\", ENV{ID_MM_FIBOCOM_FASTBOOT}=\"1\"
ATTRS{idVendor}==\"33f8\", ATTRS{idProduct}==\"01a9\", ENV{.MM_USBIFNUM}==\"03\", SUBSYSTEM==\"tty\", ENV{ID_MM_FIBOCOM_FASTBOOT}=\"1\"

LABEL=\"mm_rolling_linux_apps_port_types_end\"
" > $1/99-mm-rolling-linux-apps-port-types.rules
    # udev rules are read by udevd, not executed -- must be 0644
    chmod 644 $1/99-mm-rolling-linux-apps-port-types.rules
}
function create_fcc_unlock()
{
    for s in ${OEMUSBID_LIST[@]}
    do
        # 确定要执行的二进制路径 (FHS: no /opt, upstream review 2026-11)
        local binary_path="/usr/bin/rolling_ma"
        if [ "lenovo" == "${OEM_BUILD}" ]; then
            binary_path="/usr/lib/rolling/libmodemauth.so.1.1"
        fi

        # 创建fcc-unlock脚本
        cat > "$1/$s" << EOF
#!/bin/sh

# SPDX-License-Identifier: CC0-1.0
# 2023 Nero zhang <sinaro@sinaro.es>
#
# Rolling RW101 FCC unlock mechanism
#

# run fcc-unlock binary
$binary_path
exit $?
EOF
        chmod 755 "$1/$s"
    done

}

function create_and_install()
{
    mkdir -p ${DEB_SOFT_DIRS}/usr/lib/systemd/system/
    mkdir -p ${DEB_BIN_DIR}

    if [ "yes" == "${BUILD_CONFIG}" ]; then
        create_config_service ${DEB_SOFT_DIRS}/usr/lib/systemd/system/
        mkdir -p ${DEB_SOFT_DIRS}/usr/lib/systemd/system/rolling_config.d/
        create_config_d ${DEB_SOFT_DIRS}/usr/lib/systemd/system/rolling_config.d/
        mkdir -p ${DEB_SHARE_DIR}/rolling_config_service/
    fi
    if [ "yes" == "${BUILD_FLASH}" ]; then
        create_flash_service ${DEB_SOFT_DIRS}/usr/lib/systemd/system/
        mkdir -p ${DEB_SOFT_DIRS}/usr/lib/systemd/system/rolling_flash.d/
        create_flash_d ${DEB_SOFT_DIRS}/usr/lib/systemd/system/rolling_flash.d/
        mkdir -p ${DEB_SHARE_DIR}/rolling_flash_service/
    fi
    if [ "yes" == "${BUILD_HELPER}" ]; then
        create_helper_service ${DEB_SOFT_DIRS}/usr/lib/systemd/system/
        mkdir -p ${DEB_SOFT_DIRS}/usr/lib/systemd/system/rolling_helper.d/
        create_helper_d ${DEB_SOFT_DIRS}/usr/lib/systemd/system/rolling_helper.d/
    fi
    if [ "yes" == "${BUILD_MA}" ]; then
        DEB_MA_SERVICE_DIR="${DEB_SHARE_DIR}/rolling_ma_service"
        mkdir -p ${DEB_MA_SERVICE_DIR}/fcc-unlock.d
    fi

    # No /opt staging at all (FHS / Policy 9.1.1) and no staged empty
    # rolling_fw_pkg directory (lintian package-contains-empty-directory):
    # the runtime directory /var/lib/rolling/rolling_fw_pkg is created by
    # postinst instead (the path is compiled into rolling_flash).
    mkdir -p ${DEB_SOFT_DIRS}/usr/share/dbus-1/system.d/
    create_helper_conf ${DEB_SOFT_DIRS}/usr/share/dbus-1/system.d/
    mkdir -p ${DEB_SOFT_DIRS}/usr/lib/udev/rules.d/
    create_rule ${DEB_SOFT_DIRS}/usr/lib/udev/rules.d/
	create_lvfs_rule ${DEB_SOFT_DIRS}/usr/lib/udev/rules.d/
    # fwupd quirk drop-in ships as a dpkg-owned real file under
    # /usr/share/rolling; postinst only creates a symlink into fwupd's
    # quirk directory (upstream review 2026-11: no unmanaged copies).
    mkdir -p ${DEB_SHARE_DIR}/fwupd/quirks.d/
    create_fwupd_quirk ${DEB_SHARE_DIR}/fwupd/quirks.d/
    # NOTE: no copyright installation here (Debian policy 12.5 /
    # upstream review 2026-11).  The copyright must live at
    # /usr/share/doc/<binary-package-name>/copyright, but the binary package
    # name is owned by the downstream packaging (rolling-wwan-services), not
    # by this script.  Packaging (debian/copyright + dh_installdocs) installs
    # it; installing a generic /usr/share/doc/linux-apps/copyright from here
    # is a policy violation and collision-prone.
}

# fwupd reads every *.quirk file in its quirks.d directory.  The file content
# used to be generated by postinst directly into /usr/share/fwupd/quirks.d,
# which is a directory owned by the fwupd package (dpkg-unmanaged content).
# It is now staged here as a real package file; the postinst only links it.
function create_fwupd_quirk()
{
    cat > "$1/rolling-linux-apps.quirk" <<'ROLLING_QUIRK_EOF'
# Rolling Wireless WWAN modules handled by the ModemManager fastboot plugin.
# Shipped by the rolling-wwan-services package; linked into
# /usr/share/fwupd/quirks.d by the postinst.  Removed on purge.

[USB\VID_33F8&PID_D00D]
Plugin = fastboot
FastbootBlockSize = 16384
FastbootOperationDelay = 0
Summary = Rolling RW101 Modem (fastboot)
CounterpartGuid = USB\VID_33F8&PID_0301
CounterpartGuid = USB\VID_33F8&PID_0302

[USB\VID_33F8&PID_0302]
GType = FuMmFastbootDevice
Summary = Rollingwireless RW101-GL Module
Flags = uninhibit-modemmanager-after-fastboot-reboot,detach-at-fastboot-has-no-response
CounterpartGuid = USB\VID_33F8&PID_D00D

[USB\VID_33F8&PID_0301]
GType = FuMmFastbootDevice
Summary = Rollingwireless RW101-GL Module
Flags = uninhibit-modemmanager-after-fastboot-reboot,detach-at-fastboot-has-no-response
CounterpartGuid = USB\VID_33F8&PID_D00D
ROLLING_QUIRK_EOF

    chmod 0644 "$1/rolling-linux-apps.quirk"
}

# Normalise the modes of the staged tree.
#
# This is the single place that decides permissions, because both build paths
# consume the same tree:
#   * cpack  -> install(DIRECTORY ...) copies the tree as-is
#   * dpkg   -> dh_auto_install runs "cmake --install" with DESTDIR=debian/tmp
# If the modes were left to chance, dh_fixperms would normalise them on the
# dpkg side but not on the cpack side, and the two .deb files would differ.
# 0755 for anything executable, 0644 for everything else, 0755 for directories
# is exactly what dh_fixperms would produce, so it becomes a no-op there.
function normalize_permissions()
{
    if [ ! -d "${DEB_SOFT_DIRS}" ]; then
        return 0
    fi
    find "${DEB_SOFT_DIRS}" -type d -exec chmod 0755 {} + 2>/dev/null || true
    find "${DEB_SOFT_DIRS}" -type f -perm -u+x -exec chmod 0755 {} + 2>/dev/null || true
    find "${DEB_SOFT_DIRS}" -type f ! -perm -u+x -exec chmod 0644 {} + 2>/dev/null || true
}

function create_install()
{
    # create release dir and create config files
    # create_and_install
    # copy file to release
    if [ -d "${BUILD_DIR}/release" ];then
       rm -r ${BUILD_DIR}/release
    fi
    
    # 使用固定的安装目录，不包含项目和oem信息
    # FHS / Policy 9.1.1: no /opt -- see the staging variable block above.
    DEB_SOFT_DIRS="${BUILD_DIR}/release/dpkg"
    DEB_BIN_DIR="${DEB_SOFT_DIRS}/usr/bin"
    DEB_SHARE_DIR="${DEB_SOFT_DIRS}/usr/share/rolling"
    DEB_LIB_ROLLING_DIR="${DEB_SOFT_DIRS}/usr/lib/rolling"

    if [ "yes" == "${BUILD_CONFIG}" ]; then
        DEB_CONFIG_SERVICE_DIR="${DEB_SHARE_DIR}/rolling_config_service"
    fi
    if [ "yes" == "${BUILD_FLASH}" ]; then
        DEB_FLASH_SERVICE_DIR="${DEB_SHARE_DIR}/rolling_flash_service"
    fi
    if [ "yes" == "${BUILD_MA}" ]; then
        DEB_MA_SERVICE_DIR="${DEB_SHARE_DIR}/rolling_ma_service"
    fi
    
    create_and_install
    copy_file_to_deb_directory
    normalize_permissions
    
    # 使用固定的包名，不包含项目和oem信息
    build_package="rolling_linux"
    echo "build_package: ${build_package}"
}

create_install
